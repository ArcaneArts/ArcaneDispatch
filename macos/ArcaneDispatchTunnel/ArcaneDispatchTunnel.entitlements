<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ArcaneDispatchTunnel (Packet Tunnel Provider extension) entitlements.

  App Groups (com.apple.security.application-groups) is intentionally
  ABSENT. The provisioning profile for art.arcane.ArcaneDispatch.tunnel
  does not currently grant App Groups; claiming an unauthorized
  entitlement causes the OS to refuse to load the extension when
  startTunnel runs, which manifests as the host app spinning forever in
  "Starting…" with no log line ever arriving at the extension subsystem.

  Policy and server config are passed in via
  NETunnelProviderProtocol.providerConfiguration — see
  PacketTunnelProvider.swift for the read path. See
  macos/Runner/DebugProfile.entitlements for the App Group setup steps.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
