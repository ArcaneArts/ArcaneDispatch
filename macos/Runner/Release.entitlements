<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  IMPORTANT (Phase 5+ tunnel support):
  * Sandbox is currently OFF for local dev convenience. Before shipping the
    Network Extension you MUST flip `com.apple.security.app-sandbox` to <true/>
    and sign the app with an Apple Developer team that owns both this app's
    bundle ID (art.arcane.ArcaneDispatch) and the extension's bundle ID
    (art.arcane.ArcaneDispatch.tunnel).
  * The App Group `group.art.arcane.dispatch` must also be allowlisted in your
    Apple Developer account.
  * `com.apple.developer.networking.networkextension` requires entitlement
    approval from Apple (~2 week turnaround). Apply early.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Phase 5: shared container with the Packet Tunnel extension. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.art.arcane.dispatch</string>
	</array>
	<!-- Phase 5: container app needs to install + activate the extension. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.developer.system-extension.install</key>
	<true/>
</dict>
</plist>
