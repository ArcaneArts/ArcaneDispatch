# Copy to tools/release.env and fill in your values. The release script will
# auto-source release.env when present.
#
# You also need a notarytool keychain profile set up once with:
#   xcrun notarytool store-credentials "arcane-dispatch" \
#       --apple-id "you@example.com" \
#       --team-id "ABCDE12345" \
#       --password "app-specific-password"
#
# Then the profile name "arcane-dispatch" goes in ADL_NOTARY_PROFILE below.

ADL_TEAM_ID="ABCDE12345"
ADL_SIGNING_ID="Developer ID Application: Your Name (ABCDE12345)"
ADL_NOTARY_PROFILE="arcane-dispatch"

# Optional — overrides the default `git rev-parse --short HEAD` version stamp.
# ADL_VERSION="v1.0.0"
